class TrieNode {
    var children: [Character: TrieNode] = [:]
    var isEndOfWord: Bool = false
}

class Trie {
    private let root = TrieNode()
  
    func insert(_ word: String) {
        var current = root
        for char in word {
            if current.children[char] == nil {
                current.children[char] = TrieNode()
            }
            current = current.children[char]!
        }
        current.isEndOfWord = true
    }

    func search(_ word: String) -> Bool {
        var current = root
        for char in word {
            guard let nextNode = current.children[char] else {
                return false
            }
            current = nextNode
        }
        return current.isEndOfWord
    }
  
    func startWith(_ prefix: String) -> Bool {
        var current = root
        for char in prefix {
            guard let nextNode = current.children[char] else {
                return false
            }
            current = nextNode
        }
        return true
    }
    

    private func dfs(_ node: TrieNode, _ prefix: String, _ result: inout [String]) {
        if node.isEndOfWord {
            result.append(prefix)
        }
        for (char, child) in node.children {
            dfs(child, prefix + String(char), &result)
        }
    }
    

    func autoComplete(_ prefix: String) -> [String] {
        var current = root
        var result: [String] = []
        
        for char in prefix {
            guard let nextNode = current.children[char] else {
                return result // prefix not found
            }
            current = nextNode
        }
        
        dfs(current, prefix, &result)
        return result
    }
}

let trie = Trie()
trie.insert("cat")
trie.insert("car")
trie.insert("can")
trie.insert("dog")
trie.insert("door")
trie.insert("doll")

print("AutoComplete for 'ca':", trie.autoComplete("ca")) // ["cat", "car", "can"]
print("AutoComplete for 'do':", trie.autoComplete("do")) // ["dog", "door", "doll"]
print("AutoComplete for 'z':", trie.autoComplete("z"))   // []
