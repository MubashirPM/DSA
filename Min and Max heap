class MinHeap {
    private var heap: [Int] = []
    
    private func parent(_ index: Int) -> Int { (index - 1) / 2 }
    private func leftChild(_ index: Int) -> Int { 2 * index + 1 }
    private func rightChild(_ index: Int) -> Int { 2 * index + 2 }
    
    private func swap(_ i: Int, _ j: Int) {
        (heap[i], heap[j]) = (heap[j], heap[i])
    }
    
    func insert(_ value: Int) {
        heap.append(value)
        var i = heap.count - 1
       // while i > 0 && heap[i] > heap[parent(i)]
        while i > 0 && heap[i] < heap[parent(i)] {
            swap(i, parent(i))
            i = parent(i)
        }
    }
    
    func extractMin() -> Int? {
        guard !heap.isEmpty else { return nil }
        if heap.count == 1 { return heap.removeFirst() }
        
        let minValue = heap[0]
        heap[0] = heap.removeLast()
        
        var i = 0
        while true {
            let left = leftChild(i)
            let right = rightChild(i)
            var smallest = i
            
            if left < heap.count && heap[left] < heap[smallest] {
                smallest = left
            }
            if right < heap.count && heap[right] < heap[smallest] {
                smallest = right
            }
            if smallest == i { break }
            swap(i, smallest)
            i = smallest
        }
        return minValue
 /*
